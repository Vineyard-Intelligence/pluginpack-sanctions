{
  "identifier": "run.vineyard.typepacks.identity",
  "version": "2.5.0",
  "types": [
    {
      "category": "identity",
      "name": "person",
      "display_name": "Person",
      "description": "A natural person or persona under investigation.",
      "label_property": "full_name",
      "icon": "user",
      "color": "#d8b4fe",
      "properties": {
        "full_name": {
          "type": "string",
          "description": "Full name or primary persona name.",
          "optional": false
        },
        "aliases": {
          "type": "array",
          "description": "Other names, nicknames, or handles \u2014 one entry per name.",
          "optional": true
        },
        "date_of_birth": {
          "type": "date",
          "description": "Date of birth.",
          "optional": true
        },
        "nationality": {
          "type": "string",
          "description": "Nationality or citizenship.",
          "optional": true
        },
        "gender": {
          "type": "string",
          "description": "Gender.",
          "optional": true
        },
        "occupation": {
          "type": "string",
          "description": "Occupation or role.",
          "optional": true
        }
      }
    },
    {
      "category": "identity",
      "name": "organization",
      "display_name": "Organization",
      "description": "A company, agency, group, or other organization.",
      "label_property": "name",
      "icon": "building-2",
      "color": "#c4b5fd",
      "properties": {
        "name": {
          "type": "string",
          "description": "Organization name.",
          "optional": false
        },
        "org_type": {
          "type": "enum",
          "description": "Kind of organization.",
          "optional": true,
          "enum": [
            "company",
            "government",
            "ngo",
            "educational",
            "criminal",
            "unknown"
          ]
        },
        "country": {
          "type": "string",
          "description": "Country of incorporation or operation.",
          "optional": true
        },
        "industry": {
          "type": "string",
          "description": "Industry or sector.",
          "optional": true
        },
        "website": {
          "type": "url",
          "description": "Primary website.",
          "optional": true
        },
        "registration_number": {
          "type": "string",
          "description": "Company / registration number.",
          "optional": true
        }
      }
    }
  ]
}
